#!/usr/bin/env python3
import json, os, sys, time
if len(sys.argv) != 3 or sys.argv[1] != '--parent-pid':
    sys.exit(22)
mode = os.environ.get('ACBR_TEST_MODE', 'ok')
if mode == 'no-read':
    time.sleep(60)
req = json.loads(sys.stdin.readline())
if mode == 'hang':
    time.sleep(60)
if mode == 'flood':
    os.write(2, b'X' * 100000)
    time.sleep(60)
frame = dict(versao=1, id=req['id'], sourceRevision=req['sourceRevision'],
             contractHash=req['contractHash'], sucesso=True, estado='XML_GERADO',
             xmlBase64='PHRlc3QvPg==')
if mode == 'stderr':
    os.write(2, b'private-data-must-not-leak\n' * 50)
if mode == 'send-hang':
    print(json.dumps(dict(tipo='envioIniciado', id=req['id'])), flush=True)
    time.sleep(60)
if mode == 'id':
    frame['id'] = 'wrong'
if mode == 'contract':
    frame['contractHash'] = '0' * 64
if mode == 'base64':
    frame['xmlBase64'] = 'invalid!'
if mode == 'state':
    frame['estado'] = 'not-a-state'
if mode == 'status':
    frame['cStat'] = 0
if mode == 'bool':
    frame['sucesso'] = 'true'
if mode == 'json':
    os.write(1, b'{broken\n')
elif mode == 'utf8':
    os.write(1, b'{"x":"\xff"}\n')
elif mode == 'empty':
    pass
elif mode == 'partial':
    os.write(1, json.dumps(frame).encode())
else:
    data = (json.dumps(frame) + '\n').encode()
    if mode == 'split':
        for part in data:
            os.write(1, bytes([part]))
    else:
        os.write(1, data)
    if mode == 'duplicate':
        os.write(1, data)
    if mode == 'trailing':
        os.write(1, b'junk')
    if mode == 'exit':
        sys.exit(7)
