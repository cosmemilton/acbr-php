#!/usr/bin/env php
<?php
declare(strict_types=1);

$root = dirname(__DIR__);
$loaded = false;
foreach ([$root . '/vendor/autoload.php', dirname(__DIR__, 3) . '/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        $loaded = true;
        break;
    }
}
if (!$loaded) {
    spl_autoload_register(static function (string $class) use ($root): void {
        if (str_starts_with($class, 'Acbr\\')) {
            $file = $root . '/src/' . str_replace('\\', '/', substr($class, 5)) . '.php';
            if (is_file($file)) {
                require $file;
            }
        }
    });
}

use Acbr\AcbrException;
use Acbr\NativeRuntime;

$command = $argv[1] ?? 'help';
$arguments = array_slice($argv, 2);
$print = static function (array $value): void {
    echo json_encode($value, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR), "\n";
};
if (in_array($command, ['help', '--help', '-h'], true)) {
    echo <<<'HELP'
ACBr PHP — runtime Linux x64, revisão ACBr 48590

Uso:
  acbr-php runtime:release
  acbr-php runtime:verify [diretório]
  acbr-php runtime:diagnose [diretório]
  acbr-php runtime:install <arquivo.tgz|diretório-verificado> [destino]

A instalação é offline e aceita somente o runtime fixado em resources/runtime-release.json.
O SHA256 do arquivo é verificado antes da extração. Um destino existente nunca é substituído.
A resolução usa o diretório informado, ACBR_RUNTIME_DIR ou runtime/linux-x64 do pacote.
Verificação, diagnóstico e instalação nunca executam o motor nem acessam a SEFAZ.

HELP;
    exit(0);
}
try {
    if ($command === 'runtime:release' && count($arguments) === 0) {
        $print(NativeRuntime::release());
    } elseif ($command === 'runtime:diagnose' && count($arguments) <= 1) {
        $diagnostics = NativeRuntime::diagnostics($arguments[0] ?? null);
        $print($diagnostics);
        exit($diagnostics['ok'] ? 0 : 1);
    } elseif ($command === 'runtime:verify' && count($arguments) <= 1) {
        $runtime = NativeRuntime::resolve($arguments[0] ?? null);
        $print(['ok' => true, 'directory' => $runtime->directory, 'executable' => $runtime->executable,
            'verifiedFiles' => count($runtime->manifest['files']), 'sourceRevision' => NativeRuntime::SOURCE_REVISION,
            'contractHash' => NativeRuntime::CONTRACT_HASH, 'nativeExecutionChecked' => false]);
    } elseif ($command === 'runtime:install' && count($arguments) >= 1 && count($arguments) <= 2) {
        $runtime = NativeRuntime::install($arguments[0], $arguments[1] ?? null);
        $print(['ok' => true, 'directory' => $runtime->directory, 'verifiedFiles' => count($runtime->manifest['files']),
            'nativeExecutionChecked' => false]);
    } else {
        fwrite(STDERR, "Uso inválido. Execute acbr-php --help.\n");
        exit(2);
    }
} catch (AcbrException $error) {
    fwrite(STDERR, json_encode(['ok' => false, 'codigo' => $error->codigo, 'mensagem' => $error->getMessage()],
        JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
    exit(1);
} catch (Throwable) {
    fwrite(STDERR, "Falha interna ao verificar ou instalar o runtime. Nenhum motor foi executado.\n");
    exit(1);
}
